{
  "name": "@cuka/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "pretest": "npm -w @cuka/shared run build",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "setup": "nest build && node dist/scripts/setup.js",
    "create-admin": "nest build && node dist/scripts/create-admin.js"
  },
  "dependencies": {
    "@cuka/shared": "*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "cookie-parser": "^1.4.7",
    "minio": "^8.0.7",
    "mongoose": "^9.11.2",
    "nodemailer": "^10.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.16.18",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.2",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1",
    "typescript": "~6.0.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
