{
  "name": "cukabasement",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "npm -w @cuka/shared run build",
    "dev": "concurrently -n shared,api,worker,web \"npm -w @cuka/shared run dev\" \"npm -w @cuka/api run dev\" \"npm -w @cuka/worker run dev\" \"npm -w @cuka/web run dev\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "setup": "npm -w @cuka/api run setup",
    "create-admin": "npm -w @cuka/api run create-admin --"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "overrides": {
    "vue": "rc",
    "@vue/compiler-core": "rc",
    "@vue/compiler-dom": "rc",
    "@vue/compiler-sfc": "rc",
    "@vue/compiler-ssr": "rc",
    "@vue/compiler-vapor": "rc",
    "@vue/reactivity": "rc",
    "@vue/runtime-core": "rc",
    "@vue/runtime-dom": "rc",
    "@vue/runtime-vapor": "rc",
    "@vue/server-renderer": "rc",
    "@vue/shared": "rc",
    "@vue/compat": "rc"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
