MONGODB_URI=mongodb://localhost:27017/CukaDB
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET_ORIGINALS=cuka-originals
MINIO_BUCKET_PUBLIC=cuka-public
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
SMTP_URL=
MAIL_FROM="CukaBasement <no-reply@localhost>"
APP_URL=http://localhost:5173
API_PORT=3000
FFMPEG_PATH=ffmpeg
# Mặc định suy ra từ FFMPEG_PATH (ffmpeg → ffprobe) / defaults to the ffprobe next to FFMPEG_PATH
# FFPROBE_PATH=ffprobe
# true tắt rate limit (chỉ dùng khi dev/test) / disables rate limits, dev/test only
# THROTTLE_DISABLED=false
MONGODB_URI_TEST=mongodb://localhost:27017/CukaDB_test
NODE_ENV=development
