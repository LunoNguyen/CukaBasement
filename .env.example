MONGODB_URI=mongodb://localhost:27017/CukaDB
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET_ORIGINALS=cuka-originals
MINIO_BUCKET_PUBLIC=cuka-public
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
SMTP_URL=
MAIL_FROM="CukaBasement <no-reply@localhost>"
APP_URL=http://localhost:5173
API_PORT=3000
FFMPEG_PATH=ffmpeg
# Mặc định suy ra từ FFMPEG_PATH (ffmpeg → ffprobe) / defaults to the ffprobe next to FFMPEG_PATH
# FFPROBE_PATH=ffprobe
# true tắt rate limit (chỉ dùng khi dev/test) / disables rate limits, dev/test only
# THROTTLE_DISABLED=false
# Cache Redis cho trang chủ / tìm kiếm / trang tag; Redis tắt hay không kết nối được thì đọc thẳng MongoDB
# Redis cache for the home feed, search and tag pages; if Redis is off or unreachable lists are served from MongoDB
REDIS_URL=redis://localhost:6379
# true tắt cache Redis / disables the Redis cache
# REDIS_DISABLED=false
MONGODB_URI_TEST=mongodb://localhost:27017/CukaDB_test
NODE_ENV=development
# Thư mục chứa bản sao lưu (đường dẫn tương đối tính từ thư mục gốc repo) / backup folder (relative paths are from the repo root)
# BACKUP_DIR=backups
# Dung lượng tối đa khi tải bản sao lưu lên từ trang quản trị (byte, mặc định 50 GB) / largest backup upload from the admin page (bytes, default 50 GB)
# BACKUP_MAX_UPLOAD_BYTES=53687091200
# Múi giờ dùng cho giờ chạy sao lưu tự động / time zone of the scheduled backup time
# BACKUP_TZ=Asia/Ho_Chi_Minh
