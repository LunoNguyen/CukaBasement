# Copy to .env.docker and change every "change-me" value before exposing the site:
#   cp .env.docker.example .env.docker
# Hostnames below are docker compose service names (mongo, minio, redis, api).
NODE_ENV=production

MONGODB_URI=mongodb://mongo:27017/CukaDB

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Also used as MinIO's root user / password by the minio service.
MINIO_ACCESS_KEY=change-me-minio-user
MINIO_SECRET_KEY=change-me-minio-password-at-least-8-chars
# Browsers upload and load media straight from MinIO: this must be reachable from the browser
# (on a real host: e.g. https://media.example.com behind a reverse proxy to minio:9000).
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET_ORIGINALS=cuka-originals
MINIO_BUCKET_PUBLIC=cuka-public

# Long random strings, e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

SMTP_URL=
MAIL_FROM="CukaBasement <no-reply@localhost>"

# Public URL of the site (the web service). Also MinIO's allowed CORS origin.
APP_URL=http://localhost:8080
API_PORT=3000

FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

REDIS_URL=redis://redis:6379
# REDIS_DISABLED=false

# YOUTUBE_API_KEY=

# Inside the api/worker containers; mounted from the `backups` volume.
BACKUP_DIR=/data/backups
# BACKUP_MAX_UPLOAD_BYTES=53687091200
# BACKUP_TZ=Asia/Ho_Chi_Minh
